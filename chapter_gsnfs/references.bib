@inproceedings{10.1145/3742889.3768350,
author = {Yang, Dingxi and Qin, Zhijin},
title = {Generalizable 3D Gaussian Splatting Enabled Immersive Video Communications with Semantic Coding},
year = {2025},
isbn = {9798400719974},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3742889.3768350},
doi = {10.1145/3742889.3768350},
abstract = {A core challenge in immersive video communication is to achieve real-time 3D reconstruction and rendering while ensuring efficient multi-view source coding. Recent advances in feed-forward 3D Gaussian Splatting (3DGS) have enabled efficient 3D reconstruction from sparse stereo views, while semantic communication offers higher compression efficiency by leveraging semantic priors. In this work, we present SC-GSNet, a unified end-to-end framework that jointly performs semantic-aware multi-view video compression and generalizable 3D Gaussian Splatting. Our approach introduces a disparity-guided semantic codec capable of parallel encoding for stereo views with cross-view contextual interaction, significantly improving compression efficiency. Furthermore, real-time estimation of 3D splatting parameters from compressed semantic features is challenging due to the computational constraints of immersive applications. To address this, we propose a lightweight Gaussian parameter predictor that directly estimates 3D splatting attributes from decoded semantic features. Extensive experiments on real-world human datasets demonstrate that SC-GSNet achieves state-of-the-art rate-rendering performance, reducing BD-rate by up to 75.2\% compared with multi-view video coding standard, while maintaining real-time inference at about 19 fps. The model also exhibits strong generalizability across unseen scenes, offering a scalable, low-latency solution for immersive communications.},
booktitle = {Proceedings of the 3rd ACM Workshop on Mobile Immersive Computing, Networking, and Systems},
pages = {36–42},
numpages = {7},
keywords = {3D Gaussian Splatting, Immersive Communication, Multi-view Video Compression, Semantic Coding},
location = {Hong Kong, China},
